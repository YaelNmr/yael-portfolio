---
import { Icon } from "astro-icon/components";
---

<footer class="py-12 border-t border-white/5 bg-gray-950/50 backdrop-blur-sm">
    <div
        class="max-w-7xl mx-auto px-6 flex flex-col items-center justify-center gap-2 text-center"
    >
        <p class="text-gray-400 text-sm md:text-base">
            Yael Nemer · {new Date().getFullYear()}
        </p>

        <p class="text-gray-500 text-xs md:text-sm">
            Portfolio template originally created by Lautaro R. Collins ·
            Adapted by Yael Nemer
        </p>

        <a
            href="https://github.com/Lautaro-R-collins"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-primary transition-all duration-300 hover:scale-110 active:scale-95"
            aria-label="Original template creator's GitHub"
        >
            <Icon name="lucide:github" class="size-5" />
        </a>
    </div>
</footer>
