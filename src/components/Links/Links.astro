---
import { Icon } from "astro-icon/components";
import { PERSONAL_INFO } from "../../data/personal";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex items-center gap-6", className]}>
    {
        PERSONAL_INFO.socialLinks.map((link) => {
            let iconName = "lucide:globe";

            if (link.label === "LinkedIn") {
                iconName = "lucide:linkedin";
            } else if (link.label === "GitHub") {
                iconName = "lucide:github";
            } else if (link.label === "Email") {
                iconName = "lucide:mail";
            } else if (link.label === "Itch.io") {
                iconName = "lucide:gamepad-2";
            }

            const isEmail = link.href.startsWith("mailto:");

            return (
                <a
                    href={link.href}
                    target={isEmail ? undefined : "_blank"}
                    rel={isEmail ? undefined : "noopener noreferrer"}
                    class="text-primary hover:text-purple-400 transition-all duration-300 hover:scale-110"
                    aria-label={link.label}
                >
                    <Icon name={iconName} class="size-6 md:size-8" />
                </a>
            );
        })
    }
</div>

<style>
    .text-primary {
        color: #7836cf;
    }
</style>